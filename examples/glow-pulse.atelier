version: "1.0"
name: Glow Pulse
description: Circle with animated shadow blur and color — a breathing glow effect on a dark background
canvas:
  width: 600
  height: 400
  fps: 60
  background: "#0A0A0A"

layers:
  - id: orb
    visual:
      type: shape
      shape: { type: ellipse }
      fill: { type: solid, color: "#4A7C91" }
    frame: { x: 250, y: 150 }
    bounds: { width: 100, height: 100 }
    shadow:
      color: "#4A7C91"
      blur: 5
      offsetX: 0
      offsetY: 0

states:
  pulse:
    duration: 120
    deltas:
      # Glow expands
      - layer: orb
        property: shadow.blur
        range: [0, 60]
        from: 5
        to: 40
        easing: ease-in-out
      # Glow contracts
      - layer: orb
        property: shadow.blur
        range: [61, 120]
        from: 40
        to: 5
        easing: ease-in-out
      # Color shifts blue to purple
      - layer: orb
        property: shadow.color
        range: [0, 60]
        from: "#4A7C91"
        to: "#9B59B6"
        easing: ease-in-out
      # Color shifts back
      - layer: orb
        property: shadow.color
        range: [61, 120]
        from: "#9B59B6"
        to: "#4A7C91"
        easing: ease-in-out
      # Subtle scale pulse
      - layer: orb
        property: scale.x
        range: [0, 60]
        from: 1
        to: 1.1
        easing: ease-in-out
      - layer: orb
        property: scale.x
        range: [61, 120]
        from: 1.1
        to: 1
        easing: ease-in-out
      - layer: orb
        property: scale.y
        range: [0, 60]
        from: 1
        to: 1.1
        easing: ease-in-out
      - layer: orb
        property: scale.y
        range: [61, 120]
        from: 1.1
        to: 1
        easing: ease-in-out
