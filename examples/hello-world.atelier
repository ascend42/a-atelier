version: "1.0"
name: Hello World
description: Minimal example — one text layer with fade-in and slide-up
canvas:
  width: 600
  height: 400
  fps: 60
  background: "#1E1E1E"

layers:
  - id: title
    visual:
      type: text
      content: "Hello, Atelier"
      style:
        fontFamily: sans-serif
        fontSize: 48
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 100, y: 200 }
    bounds: { width: 400, height: 60 }
    opacity: 0

states:
  intro:
    duration: 60
    deltas:
      - layer: title
        property: opacity
        range: [0, 30]
        from: 0
        to: 1
        easing: ease-out
      - layer: title
        property: frame.y
        range: [0, 40]
        from: 220
        to: 180
        easing: ease-in-out
