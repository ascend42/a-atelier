version: "1.0"
name: The Value Prop
description: "Sequence -> hold. Code file with .purpose file beside it, AI reads structured context efficiently, comparison of tokens and time, concluding statement."
canvas:
  width: 1920
  height: 1080
  fps: 60
  background: "#0A0A0F"

layers:
  # Code file (same as the-problem, carried over visually)
  - id: code-file
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 12 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#333333", width: 2 }
    frame: { x: 200, y: 180 }
    bounds: { width: 380, height: 520 }
    opacity: 0

  - id: code-header
    visual:
      type: text
      content: "checkout.ts"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 280, y: 195 }
    bounds: { width: 220, height: 20 }
    opacity: 0

  # Simulated code lines inside
  - id: code-lines-1
    visual:
      type: text
      content: "import { Router } from 'express';"
      style:
        fontFamily: sans-serif
        fontSize: 12
        color: "#555555"
        textAlign: left
    frame: { x: 220, y: 230 }
    bounds: { width: 340, height: 16 }
    opacity: 0

  - id: code-lines-2
    visual:
      type: text
      content: "import { CartService } from '../services';"
      style:
        fontFamily: sans-serif
        fontSize: 12
        color: "#555555"
        textAlign: left
    frame: { x: 220, y: 252 }
    bounds: { width: 340, height: 16 }
    opacity: 0

  - id: code-lines-3
    visual:
      type: text
      content: "// ... 300 lines of business logic"
      style:
        fontFamily: sans-serif
        fontSize: 12
        color: "#444444"
        textAlign: left
    frame: { x: 220, y: 290 }
    bounds: { width: 340, height: 16 }
    opacity: 0

  # .purpose file shape (small rect, teal border)
  - id: purpose-file
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 10 }
      fill: { type: solid, color: "#0A1A1A" }
      stroke: { color: "#14B8A6", width: 2 }
    frame: { x: 660, y: 240 }
    bounds: { width: 320, height: 400 }
    opacity: 0
    shadow:
      color: "#14B8A6"
      blur: 0
      offsetX: 0
      offsetY: 0

  - id: purpose-header
    visual:
      type: text
      content: ".purpose"
      style:
        fontFamily: sans-serif
        fontSize: 18
        color: "#14B8A6"
        textAlign: center
    frame: { x: 730, y: 258 }
    bounds: { width: 180, height: 24 }
    opacity: 0

  - id: purpose-line-1
    visual:
      type: text
      content: "#checkout"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#3B82F6"
        textAlign: left
    frame: { x: 685, y: 300 }
    bounds: { width: 270, height: 18 }
    opacity: 0

  - id: purpose-line-2
    visual:
      type: text
      content: "  handles cart + payment"
      style:
        fontFamily: sans-serif
        fontSize: 13
        color: "#888888"
        textAlign: left
    frame: { x: 685, y: 324 }
    bounds: { width: 270, height: 18 }
    opacity: 0

  - id: purpose-line-3
    visual:
      type: text
      content: "^authenticated"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#F59E0B"
        textAlign: left
    frame: { x: 685, y: 360 }
    bounds: { width: 270, height: 18 }
    opacity: 0

  - id: purpose-line-4
    visual:
      type: text
      content: "!checkout-complete"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#EF4444"
        textAlign: left
    frame: { x: 685, y: 390 }
    bounds: { width: 270, height: 18 }
    opacity: 0

  - id: purpose-line-5
    visual:
      type: text
      content: "$checkout-flow"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#10B981"
        textAlign: left
    frame: { x: 685, y: 420 }
    bounds: { width: 270, height: 18 }
    opacity: 0

  # AI cursor reading .purpose
  - id: ai-cursor
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 2 }
      fill: { type: solid, color: "#14B8A6" }
    frame: { x: 675, y: 300 }
    bounds: { width: 290, height: 3 }
    opacity: 0
    shadow:
      color: "#14B8A6"
      blur: 8
      offsetX: 0
      offsetY: 0

  # Token counter for .purpose reading
  - id: token-label
    visual:
      type: text
      content: "Tokens consumed:"
      style:
        fontFamily: sans-serif
        fontSize: 18
        color: "#888888"
        textAlign: right
    frame: { x: 1350, y: 200 }
    bounds: { width: 250, height: 24 }
    opacity: 0

  - id: token-value
    visual:
      type: text
      content: "1,500"
      style:
        fontFamily: sans-serif
        fontSize: 48
        color: "#14B8A6"
        textAlign: right
    frame: { x: 1350, y: 235 }
    bounds: { width: 250, height: 60 }
    opacity: 0

  # Green glow on code file (AI navigates correctly)
  - id: code-glow
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 12 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#10B981", width: 3 }
    frame: { x: 198, y: 178 }
    bounds: { width: 384, height: 524 }
    opacity: 0
    shadow:
      color: "#10B981"
      blur: 0
      offsetX: 0
      offsetY: 0

  # Comparison — Without column
  - id: without-header
    visual:
      type: text
      content: "Without"
      style:
        fontFamily: sans-serif
        fontSize: 28
        color: "#888888"
        textAlign: center
    frame: { x: 460, y: 760 }
    bounds: { width: 300, height: 36 }
    opacity: 0

  - id: without-tokens
    visual:
      type: text
      content: "14,000 tokens"
      style:
        fontFamily: sans-serif
        fontSize: 22
        color: "#888888"
        textAlign: center
    frame: { x: 480, y: 810 }
    bounds: { width: 260, height: 30 }
    opacity: 0

  - id: without-time
    visual:
      type: text
      content: "~12 min"
      style:
        fontFamily: sans-serif
        fontSize: 22
        color: "#888888"
        textAlign: center
    frame: { x: 480, y: 848 }
    bounds: { width: 260, height: 30 }
    opacity: 0

  # Comparison — With Paradigm column
  - id: with-header
    visual:
      type: text
      content: "With Paradigm"
      style:
        fontFamily: sans-serif
        fontSize: 28
        color: "#14B8A6"
        textAlign: center
    frame: { x: 1060, y: 760 }
    bounds: { width: 400, height: 36 }
    opacity: 0

  - id: with-tokens
    visual:
      type: text
      content: "1,500 tokens"
      style:
        fontFamily: sans-serif
        fontSize: 22
        color: "#14B8A6"
        textAlign: center
    frame: { x: 1110, y: 810 }
    bounds: { width: 300, height: 30 }
    opacity: 0

  - id: with-time
    visual:
      type: text
      content: "~7 min"
      style:
        fontFamily: sans-serif
        fontSize: 22
        color: "#14B8A6"
        textAlign: center
    frame: { x: 1110, y: 848 }
    bounds: { width: 300, height: 30 }
    opacity: 0

  # Conclusion
  - id: conclusion
    visual:
      type: text
      content: "Structured context beats raw context. Every time."
      style:
        fontFamily: sans-serif
        fontSize: 40
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 260, y: 960 }
    bounds: { width: 1400, height: 50 }
    opacity: 0

states:
  main:
    duration: 480
    deltas:
      # Code file appears
      - layer: code-file
        property: opacity
        range: [0, 30]
        from: 0
        to: 1
        easing: ease-out
      - layer: code-header
        property: opacity
        range: [5, 30]
        from: 0
        to: 1
        easing: ease-out
      - layer: code-lines-1
        property: opacity
        range: [10, 35]
        from: 0
        to: 1
        easing: ease-out
      - layer: code-lines-2
        property: opacity
        range: [15, 40]
        from: 0
        to: 1
        easing: ease-out
      - layer: code-lines-3
        property: opacity
        range: [20, 45]
        from: 0
        to: 1
        easing: ease-out

      # .purpose file slides in from right
      - layer: purpose-file
        property: opacity
        range: [50, 85]
        from: 0
        to: 1
        easing: ease-out
      - layer: purpose-file
        property: frame.x
        range: [50, 85]
        from: 760
        to: 660
        easing: ease-out
      - layer: purpose-header
        property: opacity
        range: [60, 90]
        from: 0
        to: 1
        easing: ease-out
      - layer: purpose-line-1
        property: opacity
        range: [75, 100]
        from: 0
        to: 1
        easing: ease-out
      - layer: purpose-line-2
        property: opacity
        range: [80, 105]
        from: 0
        to: 1
        easing: ease-out
      - layer: purpose-line-3
        property: opacity
        range: [90, 115]
        from: 0
        to: 1
        easing: ease-out
      - layer: purpose-line-4
        property: opacity
        range: [95, 120]
        from: 0
        to: 1
        easing: ease-out
      - layer: purpose-line-5
        property: opacity
        range: [100, 125]
        from: 0
        to: 1
        easing: ease-out

      # AI cursor reads .purpose file — scans downward
      - layer: ai-cursor
        property: opacity
        range: [120, 130]
        from: 0
        to: 1
        easing: ease-out
      - layer: ai-cursor
        property: frame.y
        range: [130, 200]
        from: 300
        to: 430
        easing: linear
      - layer: ai-cursor
        property: opacity
        range: [200, 215]
        from: 1
        to: 0
        easing: ease-in

      # Token counter appears — stays low
      - layer: token-label
        property: opacity
        range: [130, 155]
        from: 0
        to: 1
        easing: ease-out
      - layer: token-value
        property: opacity
        range: [160, 190]
        from: 0
        to: 1
        easing: ease-out

      # .purpose file glows
      - layer: purpose-file
        property: shadow.blur
        range: [190, 230]
        from: 0
        to: 20
        easing: ease-in-out

      # Code file gets green glow (AI navigates correctly)
      - layer: code-glow
        property: opacity
        range: [230, 260]
        from: 0
        to: 1
        easing: ease-out
      - layer: code-glow
        property: shadow.blur
        range: [230, 270]
        from: 0
        to: 25
        easing: ease-in-out

      # Comparison columns fade in
      - layer: without-header
        property: opacity
        range: [280, 310]
        from: 0
        to: 1
        easing: ease-out
      - layer: without-tokens
        property: opacity
        range: [295, 320]
        from: 0
        to: 1
        easing: ease-out
      - layer: without-time
        property: opacity
        range: [305, 330]
        from: 0
        to: 1
        easing: ease-out

      - layer: with-header
        property: opacity
        range: [300, 330]
        from: 0
        to: 1
        easing: ease-out
      - layer: with-tokens
        property: opacity
        range: [315, 340]
        from: 0
        to: 1
        easing: ease-out
      - layer: with-time
        property: opacity
        range: [325, 350]
        from: 0
        to: 1
        easing: ease-out

      # Conclusion fades in
      - layer: conclusion
        property: opacity
        range: [380, 420]
        from: 0
        to: 1
        easing: ease-out
      - layer: conclusion
        property: frame.y
        range: [380, 420]
        from: 985
        to: 960
        easing: ease-out
