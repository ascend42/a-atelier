version: "1.0"
name: The Core Flow
description: "Sequence -> hold. Six processing steps slide in left to right, each a rounded rect with text inside, connected by lines."
canvas:
  width: 1920
  height: 1080
  fps: 60
  background: "#0A0A0F"

layers:
  # Title
  - id: title
    visual:
      type: text
      content: "The Core Flow"
      style:
        fontFamily: sans-serif
        fontSize: 48
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 660, y: 60 }
    bounds: { width: 600, height: 60 }
    opacity: 0

  # Step 1 — Input
  - id: step1-bg
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 14 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#F59E0B", width: 2 }
    frame: { x: 100, y: 380 }
    bounds: { width: 220, height: 140 }
    opacity: 0

  - id: step1-num
    visual:
      type: text
      content: "1"
      style:
        fontFamily: sans-serif
        fontSize: 16
        color: "#F59E0B"
        textAlign: center
    frame: { x: 180, y: 392 }
    bounds: { width: 60, height: 22 }
    opacity: 0

  - id: step1-title
    visual:
      type: text
      content: "Input"
      style:
        fontFamily: sans-serif
        fontSize: 24
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 130, y: 420 }
    bounds: { width: 160, height: 32 }
    opacity: 0

  - id: step1-desc
    visual:
      type: text
      content: "Record or import dry audio"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 115, y: 460 }
    bounds: { width: 190, height: 24 }
    opacity: 0

  # Connector 1->2
  - id: conn1
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 1 }
      fill: { type: solid, color: "#F59E0B" }
    frame: { x: 320, y: 449 }
    bounds: { width: 60, height: 2 }
    opacity: 0

  # Step 2 — Position
  - id: step2-bg
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 14 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#F59E0B", width: 2 }
    frame: { x: 380, y: 380 }
    bounds: { width: 220, height: 140 }
    opacity: 0

  - id: step2-num
    visual:
      type: text
      content: "2"
      style:
        fontFamily: sans-serif
        fontSize: 16
        color: "#F59E0B"
        textAlign: center
    frame: { x: 460, y: 392 }
    bounds: { width: 60, height: 22 }
    opacity: 0

  - id: step2-title
    visual:
      type: text
      content: "Position"
      style:
        fontFamily: sans-serif
        fontSize: 24
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 410, y: 420 }
    bounds: { width: 160, height: 32 }
    opacity: 0

  - id: step2-desc
    visual:
      type: text
      content: "Place the source in the room"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 395, y: 460 }
    bounds: { width: 190, height: 24 }
    opacity: 0

  # Connector 2->3
  - id: conn2
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 1 }
      fill: { type: solid, color: "#F59E0B" }
    frame: { x: 600, y: 449 }
    bounds: { width: 60, height: 2 }
    opacity: 0

  # Step 3 — Environment
  - id: step3-bg
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 14 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#14B8A6", width: 2 }
    frame: { x: 660, y: 380 }
    bounds: { width: 220, height: 140 }
    opacity: 0

  - id: step3-num
    visual:
      type: text
      content: "3"
      style:
        fontFamily: sans-serif
        fontSize: 16
        color: "#14B8A6"
        textAlign: center
    frame: { x: 740, y: 392 }
    bounds: { width: 60, height: 22 }
    opacity: 0

  - id: step3-title
    visual:
      type: text
      content: "Environment"
      style:
        fontFamily: sans-serif
        fontSize: 24
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 690, y: 420 }
    bounds: { width: 160, height: 32 }
    opacity: 0

  - id: step3-desc
    visual:
      type: text
      content: "Define the space"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 675, y: 460 }
    bounds: { width: 190, height: 24 }
    opacity: 0

  # Connector 3->4
  - id: conn3
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 1 }
      fill: { type: solid, color: "#14B8A6" }
    frame: { x: 880, y: 449 }
    bounds: { width: 60, height: 2 }
    opacity: 0

  # Step 4 — Listener
  - id: step4-bg
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 14 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#14B8A6", width: 2 }
    frame: { x: 940, y: 380 }
    bounds: { width: 220, height: 140 }
    opacity: 0

  - id: step4-num
    visual:
      type: text
      content: "4"
      style:
        fontFamily: sans-serif
        fontSize: 16
        color: "#14B8A6"
        textAlign: center
    frame: { x: 1020, y: 392 }
    bounds: { width: 60, height: 22 }
    opacity: 0

  - id: step4-title
    visual:
      type: text
      content: "Listener"
      style:
        fontFamily: sans-serif
        fontSize: 24
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 970, y: 420 }
    bounds: { width: 160, height: 32 }
    opacity: 0

  - id: step4-desc
    visual:
      type: text
      content: "Position the virtual microphone"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 950, y: 460 }
    bounds: { width: 200, height: 24 }
    opacity: 0

  # Connector 4->5
  - id: conn4
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 1 }
      fill: { type: solid, color: "#14B8A6" }
    frame: { x: 1160, y: 449 }
    bounds: { width: 60, height: 2 }
    opacity: 0

  # Step 5 — Render
  - id: step5-bg
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 14 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#F59E0B", width: 2 }
    frame: { x: 1220, y: 380 }
    bounds: { width: 220, height: 140 }
    opacity: 0

  - id: step5-num
    visual:
      type: text
      content: "5"
      style:
        fontFamily: sans-serif
        fontSize: 16
        color: "#F59E0B"
        textAlign: center
    frame: { x: 1300, y: 392 }
    bounds: { width: 60, height: 22 }
    opacity: 0

  - id: step5-title
    visual:
      type: text
      content: "Render"
      style:
        fontFamily: sans-serif
        fontSize: 24
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 1250, y: 420 }
    bounds: { width: 160, height: 32 }
    opacity: 0

  - id: step5-desc
    visual:
      type: text
      content: "Convolution + spatial math"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 1235, y: 460 }
    bounds: { width: 190, height: 24 }
    opacity: 0

  # Connector 5->6
  - id: conn5
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 1 }
      fill: { type: solid, color: "#F59E0B" }
    frame: { x: 1440, y: 449 }
    bounds: { width: 60, height: 2 }
    opacity: 0

  # Step 6 — Export
  - id: step6-bg
    visual:
      type: shape
      shape: { type: rect, cornerRadius: 14 }
      fill: { type: solid, color: "#1A1A2E" }
      stroke: { color: "#14B8A6", width: 2 }
    frame: { x: 1500, y: 380 }
    bounds: { width: 300, height: 140 }
    opacity: 0

  - id: step6-num
    visual:
      type: text
      content: "6"
      style:
        fontFamily: sans-serif
        fontSize: 16
        color: "#14B8A6"
        textAlign: center
    frame: { x: 1620, y: 392 }
    bounds: { width: 60, height: 22 }
    opacity: 0

  - id: step6-title
    visual:
      type: text
      content: "Export"
      style:
        fontFamily: sans-serif
        fontSize: 24
        color: "#F5F0EB"
        textAlign: center
    frame: { x: 1570, y: 420 }
    bounds: { width: 160, height: 32 }
    opacity: 0

  - id: step6-desc
    visual:
      type: text
      content: "Finished audio, environment baked in"
      style:
        fontFamily: sans-serif
        fontSize: 14
        color: "#888888"
        textAlign: center
    frame: { x: 1530, y: 460 }
    bounds: { width: 240, height: 24 }
    opacity: 0

states:
  main:
    duration: 420
    deltas:
      # Title fades in
      - layer: title
        property: opacity
        range: [0, 30]
        from: 0
        to: 1
        easing: ease-out

      # Step 1 slides in from left
      - layer: step1-bg
        property: opacity
        range: [30, 60]
        from: 0
        to: 1
        easing: ease-out
      - layer: step1-bg
        property: frame.x
        range: [30, 60]
        from: 40
        to: 100
        easing: ease-out
      - layer: step1-num
        property: opacity
        range: [40, 60]
        from: 0
        to: 1
        easing: ease-out
      - layer: step1-title
        property: opacity
        range: [40, 65]
        from: 0
        to: 1
        easing: ease-out
      - layer: step1-desc
        property: opacity
        range: [45, 68]
        from: 0
        to: 1
        easing: ease-out

      # Connector 1->2
      - layer: conn1
        property: opacity
        range: [65, 80]
        from: 0
        to: 0.5
        easing: ease-out

      # Step 2 slides in
      - layer: step2-bg
        property: opacity
        range: [75, 105]
        from: 0
        to: 1
        easing: ease-out
      - layer: step2-bg
        property: frame.x
        range: [75, 105]
        from: 320
        to: 380
        easing: ease-out
      - layer: step2-num
        property: opacity
        range: [85, 105]
        from: 0
        to: 1
        easing: ease-out
      - layer: step2-title
        property: opacity
        range: [85, 110]
        from: 0
        to: 1
        easing: ease-out
      - layer: step2-desc
        property: opacity
        range: [90, 113]
        from: 0
        to: 1
        easing: ease-out

      # Connector 2->3
      - layer: conn2
        property: opacity
        range: [110, 125]
        from: 0
        to: 0.5
        easing: ease-out

      # Step 3 slides in
      - layer: step3-bg
        property: opacity
        range: [120, 150]
        from: 0
        to: 1
        easing: ease-out
      - layer: step3-bg
        property: frame.x
        range: [120, 150]
        from: 600
        to: 660
        easing: ease-out
      - layer: step3-num
        property: opacity
        range: [130, 150]
        from: 0
        to: 1
        easing: ease-out
      - layer: step3-title
        property: opacity
        range: [130, 155]
        from: 0
        to: 1
        easing: ease-out
      - layer: step3-desc
        property: opacity
        range: [135, 158]
        from: 0
        to: 1
        easing: ease-out

      # Connector 3->4
      - layer: conn3
        property: opacity
        range: [155, 170]
        from: 0
        to: 0.5
        easing: ease-out

      # Step 4 slides in
      - layer: step4-bg
        property: opacity
        range: [165, 195]
        from: 0
        to: 1
        easing: ease-out
      - layer: step4-bg
        property: frame.x
        range: [165, 195]
        from: 880
        to: 940
        easing: ease-out
      - layer: step4-num
        property: opacity
        range: [175, 195]
        from: 0
        to: 1
        easing: ease-out
      - layer: step4-title
        property: opacity
        range: [175, 200]
        from: 0
        to: 1
        easing: ease-out
      - layer: step4-desc
        property: opacity
        range: [180, 203]
        from: 0
        to: 1
        easing: ease-out

      # Connector 4->5
      - layer: conn4
        property: opacity
        range: [200, 215]
        from: 0
        to: 0.5
        easing: ease-out

      # Step 5 slides in
      - layer: step5-bg
        property: opacity
        range: [210, 240]
        from: 0
        to: 1
        easing: ease-out
      - layer: step5-bg
        property: frame.x
        range: [210, 240]
        from: 1160
        to: 1220
        easing: ease-out
      - layer: step5-num
        property: opacity
        range: [220, 240]
        from: 0
        to: 1
        easing: ease-out
      - layer: step5-title
        property: opacity
        range: [220, 245]
        from: 0
        to: 1
        easing: ease-out
      - layer: step5-desc
        property: opacity
        range: [225, 248]
        from: 0
        to: 1
        easing: ease-out

      # Connector 5->6
      - layer: conn5
        property: opacity
        range: [245, 260]
        from: 0
        to: 0.5
        easing: ease-out

      # Step 6 slides in
      - layer: step6-bg
        property: opacity
        range: [255, 285]
        from: 0
        to: 1
        easing: ease-out
      - layer: step6-bg
        property: frame.x
        range: [255, 285]
        from: 1440
        to: 1500
        easing: ease-out
      - layer: step6-num
        property: opacity
        range: [265, 285]
        from: 0
        to: 1
        easing: ease-out
      - layer: step6-title
        property: opacity
        range: [265, 290]
        from: 0
        to: 1
        easing: ease-out
      - layer: step6-desc
        property: opacity
        range: [270, 293]
        from: 0
        to: 1
        easing: ease-out
