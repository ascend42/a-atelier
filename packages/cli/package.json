{
  "name": "@a-company/atelier",
  "version": "0.33.0",
  "description": "CLI tool — validate, preview, render, info commands",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atelier": "./dist/cli.js",
    "atelier-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@a-company/atelier-studio": ">=0.25.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^13.0.0",
    "vite": "^6.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "canvas": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@a-company/atelier-types": "workspace:*",
    "@a-company/atelier-schema": "workspace:*",
    "@a-company/atelier-core": "workspace:*",
    "@a-company/atelier-canvas": "workspace:*",
    "@a-company/atelier-svg": "workspace:*",
    "@a-company/atelier-lottie": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
