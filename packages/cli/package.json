{
  "name": "@a-company/atelier",
  "version": "1.0.0",
  "description": "Atelier: an AI-native animation engine and design/produce studio for Claude Code. CLI, MCP server, and the atelier design and atelier produce skills.",
  "license": "MIT",
  "author": "Matt Canoy (https://github.com/ascend42)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-atelier.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ascend42/a-atelier#readme",
  "bugs": {
    "url": "https://github.com/ascend42/a-atelier/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atelier": "./dist/cli.js",
    "atelier-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "templates/**",
    "src/web/**",
    "university/**"
  ],
  "paradigm": {
    "universityPack": "university/"
  },
  "scripts": {
    "build": "tsup",
    "bundle-university": "node scripts/bundle-university.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist university",
    "prepublishOnly": "pnpm run build && pnpm run bundle-university"
  },
  "dependencies": {
    "@a-company/atelier-mcp": "workspace:*",
    "@a-company/atelier-studio": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/canvas": "^0.1.0",
    "commander": "^13.0.0",
    "vite": "^6.1.0",
    "ws": "^8.20.1",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "canvas": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@a-company/atelier-canvas": "workspace:*",
    "@a-company/atelier-core": "workspace:*",
    "@a-company/atelier-lottie": "workspace:*",
    "@a-company/atelier-schema": "workspace:*",
    "@a-company/atelier-svg": "workspace:*",
    "@a-company/atelier-types": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "atelier",
    "claude-code",
    "mcp",
    "animation",
    "design-system",
    "brand",
    "video",
    "lottie",
    "svg"
  ]
}
