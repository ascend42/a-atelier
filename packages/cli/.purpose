version: 1.0.0
description: CLI tool — lint, validate, info, still, render, export-svg, export-lottie, assets, and variables commands for .atelier animation files
context:
  - Command-line interface for working with .atelier YAML animation files
  - Lint command runs all named gates (^valid-document, ^valid-delta, ^valid-video-layer) with grouped output and --json flag
  - Validate command checks schema + delta overlaps (legacy, predates named gates)
  - Info command outputs document summary
  - Still command resolves a frame and outputs JSON or PNG
  - Render command produces MP4/GIF via FFmpeg (requires node-canvas + FFmpeg)
components:
  cli-lint:
    description: Lint command — runs ^valid-document, ^valid-delta, ^valid-video-layer gates across one or more files; supports --json for CI
    file: src/commands/lint.ts
    tags: [lint, gates, ci, video]
  cli-validate:
    description: Validate command — checks .atelier files for schema validity and delta overlaps (legacy; lint is preferred)
    file: src/commands/validate.ts
  cli-info:
    description: Info command — outputs document summary (canvas, layers, states, presets)
    file: src/commands/info.ts
  cli-still:
    description: Still command — resolves a frame and outputs computed layer states as JSON
    file: src/commands/still.ts
  cli-render:
    description: Render command — renders animation to MP4 or GIF via FFmpeg
    file: src/commands/render.ts
  render-pipeline:
    description: Core render pipeline — frame loop, FFmpeg spawning, image preloading
    file: src/commands/render-pipeline.ts
  cli-export-svg:
    description: Export SVG command — renders a frame as SVG via @atelier/svg
    file: src/commands/export-svg.ts
  cli-export-lottie:
    description: Export Lottie command — exports document to Lottie JSON via @atelier/lottie
    file: src/commands/export-lottie.ts
  cli-assets:
    description: Assets command — lists all assets in a document with usage info
    file: src/commands/assets.ts
  cli-variables:
    description: Variables command — lists all variables in a document with usage info
    file: src/commands/variables.ts
  '#video-project':
    description: VideoProject filesystem utilities — createVideoProject, loadVideoProject, readCutList/writeCutList, readTranscript/writeTranscript, readComposition/writeComposition — scaffold and manage the source.mp4/project.atelier/transcript.json/cuts.json/export/ folder convention
    file: src/lib/video-project.ts
    tags: [video, ugc, editing, filesystem]
