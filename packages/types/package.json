{
  "name": "@a-company/atelier-types",
  "version": "0.31.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Pure TypeScript type definitions for the Atelier animation format",
  "license": "MIT",
  "author": "Matt Canoy (https://github.com/ascend42)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-atelier.git",
    "directory": "packages/types"
  },
  "homepage": "https://github.com/ascend42/a-atelier#readme",
  "bugs": {
    "url": "https://github.com/ascend42/a-atelier/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
