version: 1.0.0
name: "@atelier/types"
description: Pure TypeScript type definitions for the Atelier animation format — zero runtime
context:
  - This is a type-only package — every export is a type or interface
  - No runtime code, no classes, no functions
  - All other @atelier packages depend on these types
  - 60+ types across 16 modules

components:
  '#unit-types':
    description: Pixel, Percentage, and UnitValue type definitions
    file: src/units.ts
    tags: [types, units]
  '#coordinate-types':
    description: Frame, Bounds, AnchorPoint spatial types
    file: src/coordinates.ts
    tags: [types, coordinates]
  '#color-types':
    description: RGBAColor, HSLAColor, HexColor, Color union type
    file: src/color.ts
    tags: [types, color]
  '#shape-types':
    description: Shape primitives (rect, ellipse, path), fill, stroke, text style
    file: src/shape.ts
    tags: [types, shapes, visual]
  '#layer-types':
    description: Layer, Visual union (shape, text, image, video, group, ref), VideoVisual (startFrame/sourceOffset/sourceEnd/playbackRate/objectFit), SpritesheetConfig, ImageVisual.sourceRect/spritesheet/frameIndex, Layer.tint
    file: src/layer.ts
    tags: [types, layers, video]
  '#easing-types':
    description: Easing definitions — linear, cubic-bezier, spring, step, presets
    file: src/easing.ts
    tags: [types, easing]
  '#delta-types':
    description: Delta (animation instruction), AnimatableProperty (35 members), FrameRange
    file: src/delta.ts
    tags: [types, animation]
  '#state-types':
    description: State (named choreography with duration and deltas)
    file: src/state.ts
    tags: [types, state]
  '#document-types':
    description: AtelierDocument root type, Canvas config
    file: src/document.ts
    tags: [types, document]
  '#shadow-types':
    description: Shadow type — drop shadow/glow effect (color, blur, offsetX, offsetY)
    file: src/shadow.ts
    tags: [types, effects]
  '#timeline-types':
    description: Timeline, TimelineTrack, TimelineClip — derived clip-placement summary on video projects (writer-regenerated, reader-tolerant hint)
    file: src/timeline.ts
    tags: [types, timeline, video, v1]
  '#slides-types':
    description: SlideRef, SlideTransition — carousel slide refs pointing at any .atelier in the workspace (cycle-safety is the resolver's responsibility)
    file: src/slides.ts
    tags: [types, slides, carousel, v1]
  '#design-types':
    description: AtelierDesign, AtelierDesignRelation, DesignTypography, DesignMotion — per-file design block. Self-contained (no auto-cascade); lineage via relatedTo[].
    file: src/design.ts
    tags: [types, design, brand, v1]
  '#asset-types':
    description: AssetType enum, Asset type — external referenced assets (image, svg, font, animation, audio, video) with optional spritesheet/videoMeta metadata
    file: src/asset.ts
    tags: [types, assets, video]
  '#variable-types':
    description: VariableType enum, Variable type — template variable slots (string, number, color, asset, boolean)
    file: src/variable.ts
    tags: [types, variables, templates]
  '#interaction-types':
    description: TriggerType, Trigger, ActionType, Action, Interaction — trigger-action bindings for layer interactivity
    file: src/interaction.ts
    tags: [types, interactions, events]
  '#preset-types':
    description: PresetDelta, Preset — reusable animation delta templates
    file: src/preset.ts
    tags: [types, presets]
  '#video-project-types':
    description: VideoProject filesystem types — CutEntry, VideoCutList, TranscriptWord, TranscriptSegment, VideoTranscript, VideoProjectManifest — define the project folder convention for UGC editing
    file: src/video-project.ts
    tags: [types, video, ugc, editing]
  '#recipe-types':
    description: 'Studio Recipe types — StudioRecipe (top-level), SilencePolicy, CaptionStyle, CaptionGrouping (Phase 1), plus Phase 1.5 OverlayRules / OverlayHandleRule / OverlayPageNumberRule / OverlayTextStyle / OverlayAnchor. Other Phase 3 sections (caption_highlight, transition_kit, palette, audio_policy, aspect_targets) parse opaque.'
    file: src/recipe.ts
    tags: [types, recipe, studio-recipe, video]
aspects:
  unit-value-pixel-or-percent-string:
    description: 'UnitValue is Pixel (raw number) OR a Percentage template-literal string `${number}%` — so "50%" is valid but a bare 50 means 50 pixels, not 50 percent. Anything consuming a UnitValue must branch on typeof to resolve percent against a reference dimension.'
    tags:
      - units
      - convention
      - type-union
    anchors:
      - packages/types/src/units.ts:2-8
    enforcement: type union (number | template-literal)
    appliesTo: ["#unit-types"]
  frame-bounds-use-unitvalue-anchor-does-not:
    description: 'Frame (x,y) and Bounds (width,height) are UnitValue so they accept percentages, but AnchorPoint (x,y) is a plain number normalized 0-1 (0,0 = top-left, 1,1 = bottom-right) — NOT a UnitValue. Treating anchorPoint as pixels or percent is the classic mistake.'
    tags:
      - units
      - normalized
      - gotcha
    anchors:
      - packages/types/src/coordinates.ts:4-19
    enforcement: number 0-1 normalized vs UnitValue
    appliesTo: ["#coordinate-types"]
  color-union-mixed-channel-ranges:
    description: 'Color is a union of RGBAColor | HSLAColor | HexColor (a plain string), with no discriminant field — callers must structurally sniff (r/g/b vs h/s/l vs string). RGBAColor channels are 0-255 but its alpha a is 0-1, an inconsistent range within the same object.'
    tags:
      - color
      - value-range
      - gotcha
    anchors:
      - packages/types/src/color.ts:1-21
    enforcement: structural union + mixed 0-255 / 0-1
    appliesTo: ["#color-types"]
  shape-fill-discriminated-by-type:
    description: 'Shape (rect|ellipse|path) and Fill (solid|linear-gradient|radial-gradient) are both discriminated unions on a `type` string literal. RectShape.cornerRadius is either one number (uniform) or a 4-tuple of numbers (per-corner); PathShape requires points and only PathShape carries them.'
    tags:
      - discriminated-union
      - shapes
    anchors:
      - packages/types/src/shape.ts:14-30
      - packages/types/src/shape.ts:38-56
    enforcement: type-literal discriminant
    appliesTo: ["#shape-types"]
  shape-normalized-and-unit-fields:
    description: 'GradientStop.offset, Stroke.strokeStart (default 0) and Stroke.strokeEnd (default 1) are all 0-1 normalized fractions, while LinearGradientFill.angle is degrees and Stroke.width is pixels — mixed units across the shape module. RadialGradientFill center/radius are UnitValue (percent-capable).'
    tags:
      - value-range
      - units
      - shapes
    anchors:
      - packages/types/src/shape.ts:33-36
      - packages/types/src/shape.ts:58-66
    enforcement: 0-1 normalized vs degrees vs px vs UnitValue
    appliesTo: ["#shape-types"]
  text-style-required-fields:
    description: 'TextStyle requires fontFamily, fontSize, and color; everything else (fontWeight, fontStyle, textAlign, lineHeight, letterSpacing) is optional. fontWeight accepts a number OR the strings "normal"/"bold" — a mixed-type field a renderer must handle both ways.'
    tags:
      - required-field
      - shapes
      - text
    anchors:
      - packages/types/src/shape.ts:68-77
    enforcement: required field + mixed-type union
    appliesTo: ["#shape-types"]
  visual-discriminated-six-variants:
    description: 'Visual is a 6-way discriminated union on `type` (shape|text|image|video|group|ref). Adding a new visual kind requires editing this union AND every exhaustive switch over Visual.type across the codebase — the type is the single source for "what can a layer be".'
    tags:
      - discriminated-union
      - core-invariant
      - layers
    anchors:
      - packages/types/src/layer.ts:80
    enforcement: type-literal discriminant (6 variants)
    appliesTo: ["#layer-types"]
  video-visual-frames-vs-seconds:
    description: 'VideoVisual mixes time units in one object — startFrame is COMPOSITION FRAMES (when the clip enters the timeline) while sourceOffset and sourceEnd are SECONDS into the source media, and sourceEnd must exceed sourceOffset to play any range. volume is 0-1, playbackRate defaults to 1.0. Confusing frames and seconds here silently mis-times video.'
    tags:
      - units
      - video
      - core-invariant
      - cross-field
    anchors:
      - packages/types/src/layer.ts:43-63
    enforcement: frames vs seconds per field
    appliesTo: ["#layer-types"]
  layer-normalized-transform-fields:
    description: 'Layer.opacity is 0-1, rotation is degrees, scale is a {x,y} factor (1 = unchanged), and only frame/bounds are UnitValue. tint is {color: string, amount: number} where amount is the 0-1 blend strength. visible defaults to true when omitted; visual/frame/bounds are the only required Layer fields.'
    tags:
      - value-range
      - units
      - required-field
      - layers
    anchors:
      - packages/types/src/layer.ts:154-184
    enforcement: 0-1 / degrees / factor per field
    appliesTo: ["#layer-types"]
  easing-objects-or-preset-string:
    description: 'Easing is EITHER a discriminated object (linear|cubic-bezier|spring|step keyed by type) OR a bare preset string (linear|ease-in|ease-out|ease-in-out) — note "linear" exists in BOTH forms. SpringEasing fields are all optional (engine defaults), but CubicBezier requires x1/y1/x2/y2 and StepEasing requires steps.'
    tags:
      - discriminated-union
      - easing
      - gotcha
    anchors:
      - packages/types/src/easing.ts:1-30
    enforcement: object-union OR string-preset
    appliesTo: ["#easing-types"]
  animatable-property-closed-dotpath-union:
    description: 'AnimatableProperty is a CLOSED union of ~35 dot-path string literals (e.g. "frame.x", "visual.fill.color", "tint.amount"). Animating a property not listed here is a type error; adding a new animatable property means editing this union AND the runtime Zod source in @a-company/atelier-schema (noted in the file comment).'
    tags:
      - closed-union
      - core-invariant
      - animation
    anchors:
      - packages/types/src/delta.ts:3-39
    enforcement: closed string-literal union (~35 members)
    appliesTo: ["#delta-types"]
  delta-range-inclusive-from-to-unknown:
    description: 'FrameRange is a [start, end] tuple that is INCLUSIVE and 0-based. Delta.from and Delta.to are typed `unknown` — the value type is implied by the property being animated (number, color, boolean, string), so consumers must coerce/validate at runtime; the type system will not catch a mismatched from/to.'
    tags:
      - escape-hatch
      - animation
      - gotcha
    anchors:
      - packages/types/src/delta.ts:41-63
    enforcement: inclusive tuple + unknown from/to
    appliesTo: ["#delta-types"]
  state-duration-required-parent-overrides:
    description: 'State.duration (frames) and State.deltas are required; parent is a state-name string whose deltas are inherited with CHILD-OVERRIDES-WIN semantics. transitions is a map keyed by TARGET state name, each value a StateTransitionConfig whose duration is in frames.'
    tags:
      - required-field
      - state
      - inheritance
    anchors:
      - packages/types/src/state.ts:14-27
    enforcement: required duration/deltas + keyed override
    appliesTo: ["#state-types"]
  document-canvas-and-keyed-maps:
    description: 'AtelierDocument requires version, name, canvas, layers (array) and states. states/variables/assets/presets are RECORDs keyed by id, but layers is an ARRAY (order matters for z-stacking). Canvas requires width, height, fps; background is optional.'
    tags:
      - required-field
      - document
      - structure
    anchors:
      - packages/types/src/document.ts:8-30
    enforcement: required fields + record-vs-array
    appliesTo: ["#document-types"]
  shadow-color-and-blur-required:
    description: 'Shadow requires color (a full Color union value) and blur (pixels); offsetX/offsetY are optional and default to 0 (a centered glow). Reusing the Color union means a shadow color can itself be RGBA, HSLA, or a hex string.'
    tags:
      - required-field
      - effects
    anchors:
      - packages/types/src/shadow.ts:4-9
    enforcement: required color + blur
    appliesTo: ["#shadow-types"]
  audiovisual-layer-not-state-scoped:
    description: 'v1.0: audio is a first-class AudioVisual layer (type: "audio"), not a per-state field. Mixes time units like VideoVisual — sourceOffset/sourceEnd in SECONDS into the source; startFrame in COMPOSITION FRAMES; fadeIn/fadeOut in seconds at layer edges. State.audio was REMOVED in v1.0; pre-v1 docs strip the field on read (Zod default strip-unknown-keys).'
    tags:
      - units
      - audio
      - layer-scoped
      - v1-breaking
    anchors:
      - packages/types/src/layer.ts:65-95
    enforcement: seconds vs frames per field; State.audio removed
    appliesTo: ["#layer-types"]
  asset-videometa-required-for-video-gate:
    description: 'Asset.type is a 6-value closed enum (image|svg|font|animation|audio|video). videoMeta is OPTIONAL in TypeScript but REQUIRED at validation time for the ^valid-video-layer gate (per the field comment) — a video asset without videoMeta type-checks yet fails the gate. spritesheet metadata is image-only.'
    tags:
      - closed-union
      - required-by-gate
      - assets
      - video
    anchors:
      - packages/types/src/asset.ts:1
      - packages/types/src/asset.ts:11-12
    enforcement: closed enum + gate-required field
    appliesTo: ["#asset-types"]
  variable-type-enum-default-unknown:
    description: 'VariableType is a 5-value closed enum (string|number|color|asset|boolean). Variable.default is typed `unknown` — its real type is implied by Variable.type, so binding/validation must reconcile the declared type against the default at runtime; the type system will not enforce it.'
    tags:
      - closed-union
      - escape-hatch
      - variables
    anchors:
      - packages/types/src/variable.ts:1-8
    enforcement: closed enum + unknown default
    appliesTo: ["#variable-types"]
  interaction-trigger-action-discriminants:
    description: 'TriggerType (6 values) and ActionType (4 values) are closed unions, and Trigger/Action use a discriminated-by-type shape where the OTHER fields are conditionally meaningful — e.g. Trigger.delay only for "timer", Action.state only for "go-to-state", Action.value (unknown) only for "set-variable". An Interaction binds exactly one trigger to one action and requires id.'
    tags:
      - discriminated-union
      - closed-union
      - interactions
    anchors:
      - packages/types/src/interaction.ts:2-29
    enforcement: type-keyed conditional fields
    appliesTo: ["#interaction-types"]
  preset-delta-omits-layer-offset-relative:
    description: 'PresetDelta deliberately has NO `layer` field — the target layer is supplied at application time, which is what makes a Preset reusable across layers. Its offset is a RELATIVE [start,end] tuple measured from the application point, not absolute composition frames; from/to are unknown like Delta.'
    tags:
      - escape-hatch
      - presets
      - core-invariant
    anchors:
      - packages/types/src/preset.ts:4-12
    enforcement: no layer field + relative offset
    appliesTo: ["#preset-types"]
  video-project-parametric-cuts-v11-migration:
    description: 'CutEntry stores immutable detected boundaries (rawStart/rawEnd, seconds) separately from user-tunable paddingPre/paddingPost (seconds) — effective span = rawStart - paddingPre / rawEnd + paddingPost, clamped to source. VideoCutList version is "1.1"; loaders migrate flat 1.0 {start,end} on read but writers always emit 1.1.'
    tags:
      - versioned-migration
      - video
      - cross-field
    anchors:
      - packages/types/src/video-project.ts:11-38
    enforcement: raw + padding parametric, v1.1 emit
    appliesTo: ["#video-project-types"]
  transcript-editable-words-preserve-flags:
    description: 'TranscriptWord splits detected (immutable Whisper output) from text (user-overridable render value); userEdited/userAdded/hidden flags SURVIVE re-transcribe by matching on timing + detected text. start/end are SECONDS and audio-anchored — they never move on text edits. VideoTranscript version is "1.1" with 1.0→1.1 migration on load.'
    tags:
      - versioned-migration
      - video
      - convention
    anchors:
      - packages/types/src/video-project.ts:47-89
    enforcement: detected vs text + flag preservation
    appliesTo: ["#video-project-types"]
  recipe-typed-phase1-vs-opaque-phase3:
    description: 'StudioRecipe has only version + name required; silence_policy / caption_style / caption_grouping (Phase 1) and overlay_rules (Phase 1.5) are fully typed, but caption_highlight / transition_kit / palette / audio_policy / aspect_targets are typed `unknown`/`unknown[]` so Phase 1 recipes stay forward-compatible with Phase 3 without schema changes.'
    tags:
      - escape-hatch
      - recipe
      - forward-compat
    anchors:
      - packages/types/src/recipe.ts:10-42
    enforcement: typed Phase 1 + unknown Phase 3
    appliesTo: ["#recipe-types"]
  recipe-snakecase-and-unit-conventions:
    description: 'Recipe fields use snake_case (not the camelCase of the core types), and units differ by block — SilencePolicy paddings/min_silence/match_tolerance are SECONDS, CaptionStyle y_ratio/width_ratio are 0-1 ratios of canvas, fade_seconds is seconds, CaptionGrouping pause_gap is seconds. OverlayRules use anchor (corner enum) + margin (px), NOT y_ratio.'
    tags:
      - convention
      - value-range
      - units
      - recipe
    anchors:
      - packages/types/src/recipe.ts:45-79
      - packages/types/src/recipe.ts:87-132
    enforcement: snake_case + per-block units
    appliesTo: ["#recipe-types"]
