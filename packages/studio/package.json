{
  "name": "@a-company/atelier-studio",
  "version": "0.28.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Reusable editor widget for Atelier animations — canvas preview, YAML viewer, and GUI editor",
  "license": "MIT",
  "author": "Matt Canoy (https://github.com/ascend42)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-atelier.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/ascend42/a-atelier#readme",
  "bugs": {
    "url": "https://github.com/ascend42/a-atelier/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a-company/atelier-canvas": "workspace:*",
    "@a-company/atelier-core": "workspace:*",
    "@a-company/atelier-math": "workspace:*",
    "@a-company/atelier-schema": "workspace:*",
    "@a-company/atelier-types": "workspace:*",
    "mediabunny": "^1.45.4",
    "mp4-muxer": "^5.1.3",
    "webm-muxer": "^5.0.1"
  },
  "devDependencies": {
    "happy-dom": "^15.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
