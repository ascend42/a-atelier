{
  "name": "@a-company/atelier-mcp",
  "version": "0.27.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server — AI authoring interface for animations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "bin": {
    "atelier-mcp": "./dist/index.js"
  },
  "dependencies": {
    "@a-company/atelier-canvas": "workspace:*",
    "@a-company/atelier-core": "workspace:*",
    "@a-company/atelier-lottie": "workspace:*",
    "@a-company/atelier-schema": "workspace:*",
    "@a-company/atelier-svg": "workspace:*",
    "@a-company/atelier-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.20.1",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
