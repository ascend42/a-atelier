{
  "name": "@a-company/atelier-hyperframes-adapter",
  "version": "0.0.2",
  "description": "Atelier v2 adapter — emits Hyperframes projects from DESIGN/SCRIPT/STORYBOARD artifacts + asset bindings",
  "license": "MIT",
  "author": "Matt Canoy (https://github.com/ascend42)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascend42/a-atelier.git",
    "directory": "packages/hyperframes-adapter"
  },
  "homepage": "https://github.com/ascend42/a-atelier#readme",
  "bugs": {
    "url": "https://github.com/ascend42/a-atelier/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a-company/atelier-schema": "workspace:*",
    "@a-company/atelier-types": "workspace:*",
    "@hyperframes/producer": "^0.6.52"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
