version: 1.0.0
name: "@atelier/schema"
description: Zod validation schemas with AI-readable error messages and YAML parsing
context:
  - Every Zod schema mirrors an @atelier/types type definition exactly
  - Validation errors are flat and human/AI-readable (path + message)
  - YAML parsing uses the yaml package — parseAtelier() and serializeAtelier()
  - Roundtrip tested: parse -> validate -> serialize -> parse matches

components:
  '#document-schema':
    description: AtelierDocumentSchema — root Zod schema composing all sub-schemas
    file: src/document.ts
    tags: [validation, schema]
    components: ["#atelier-types"]
  '#layer-schema':
    description: LayerSchema and Visual discriminated union validation — includes VideoVisualSchema (startFrame, sourceOffset, sourceEnd, playbackRate, objectFit)
    file: src/layer.ts
    tags: [validation, schema, video]
  '#delta-schema':
    description: DeltaSchema with AnimatablePropertySchema (35 members, canonical source imported by MCP) and FrameRange refinement
    file: src/delta.ts
    tags: [validation, schema]
  '#validation-functions':
    description: validateDocument, validateLayer, validateDelta, validateVideoLayer, validateRecipe — typed results with error formatting; validateVideoLayer enforces ^valid-video-layer semantic constraints; validateRecipe enforces ^valid-recipe gate and warns on still-reserved Phase 3 fields
    file: src/validate.ts
    tags: [validation, api, video, recipe]
  '#recipe-schema':
    description: 'Studio Recipe Zod schemas — StudioRecipeSchema (top-level), SilencePolicySchema, CaptionStyleSchema, CaptionGroupingSchema (Phase 1); OverlayRulesSchema + OverlayHandleRuleSchema + OverlayPageNumberRuleSchema + OverlayTextStyleSchema + OverlayAnchorSchema (Phase 1.5 first-class; anchor enum, non-empty handle text, page-number format template validation — balanced braces, recognized {current}/{total} placeholders with optional :0Nd zero-pad). RESERVED_RECIPE_FIELDS still covers caption_highlight, transition_kit, palette, audio_policy, aspect_targets.'
    file: src/recipe.ts
    tags: [validation, schema, recipe, studio-recipe, video]
  '#yaml-parser':
    description: parseAtelier (YAML to validated doc) and serializeAtelier (doc to YAML)
    file: src/parse.ts
    tags: [parsing, yaml]
  '#workspace-schema':
    description: 'WorkspaceManifestSchema — Zod schema for `workspace.atelier`, the YAML manifest at the root of an Atelier workspace (a layer above Project that holds multiple content Projects with shared creator-level config). Fields: version (literal "1.0"), name (display, default basename(dir) at create time), created (ISO 8601), default_mode (ambient|explicit — inherited by new projects via `atelier init`), projects? (advisory relative subdir names; on-disk truth wins — `listProjects` refreshes), description?. .strict() — unknown keys are hard errors so authoring typos surface at validate time, matching the recipe-schema posture. workspace.atelier is intentionally YAML (distinguishes it from project.atelier which is JSON) and shares the .atelier extension as a family marker; the two never collide in a single directory.'
    file: src/workspace.ts
    tags: [validation, schema, workspace]
  '#artifact-schemas':
    description: 'Front-of-pipeline artifact Zod schemas (Phase 2) — DesignArtifactSchema, ScriptArtifactSchema (discriminatedUnion on mode: narrated|carousel|text-only), StoryboardArtifactSchema; SlotRefSchema enforces closed-kind / open-tail vocabulary (kind ∈ image|video|audio|text|font|voice|logo); TechniqueLibrarySchema registers versioned technique sets (v1 ships text.split-reveal, image.ken-burns.slow, super.weight-pulse-on-keyword, background.color-shift-to-token); parseDesign/parseScript/parseStoryboard split YAML frontmatter from Markdown body and validate; validateArtifactSet runs cross-artifact rules (storyboard-id ⊆ script-ids ∪ b-roll.*, slot kind closure, technique-library membership, duration overrun = warn-only pre-VO).'
    file: src/artifacts/index.ts
    tags: [validation, schema, artifacts, design, script, storyboard]

gates:
  ^valid-document:
    description: Document passes full Zod schema validation
  ^valid-delta:
    description: Delta references valid property and has valid frame range
  ^valid-video-layer:
    description: VideoVisual passes semantic checks — sourceEnd > sourceOffset, sourceEnd ≤ videoMeta.duration if present, assetId non-empty
  ^valid-recipe:
    description: StudioRecipe passes Zod validation including overlay_rules (anchor enum, page-number format template syntax)
  ^valid-artifact-set:
    description: 'Cross-artifact rules pass — every STORYBOARD beat id matches a SCRIPT beat id or is prefixed `b-roll.`; all slot refs use a known kind from the closed enum; all techniques exist in the resolved technique library; duration sum within target (warn-only pre-VO).'

aspects:
  document-shape-asymmetry:
    description: 'AtelierDocumentSchema is pure composition with one load-bearing asymmetry — layers is an ARRAY (order-significant) while states is a RECORD keyed by state name; canvas width/height/fps must all be positive integers (z.number().int().positive). Mixing these up (record of layers, array of states) silently breaks every downstream resolver.'
    tags:
      - schema
      - convention
      - composition
    anchors:
      - packages/schema/src/document.ts:12-14
      - packages/schema/src/document.ts:38-39
    enforcement: array vs record + int().positive() bounds
    appliesTo: ["#document-schema"]
  visual-discriminated-union:
    description: 'VisualSchema is a discriminatedUnion on the literal "type" field across shape/text/image/video/group/ref — Zod uses type to pick exactly one branch, so a wrong or missing type yields a single clear error instead of unioning every branch error. Adding a new visual kind requires both a literal("type") member and a union entry.'
    tags:
      - schema
      - discriminated-union
      - core-invariant
    anchors:
      - packages/schema/src/layer.ts:82-89
    enforcement: z.discriminatedUnion on "type" literal
    appliesTo: ["#layer-schema"]
  video-bound-asymmetry:
    description: 'VideoVisual numeric bounds are deliberately asymmetric — sourceOffset is min(0) (a 0-second start is valid) but sourceEnd is positive() (an end of 0 is meaningless), playbackRate is positive(), and volume is clamped min(0).max(1). These are Zod-level shape checks only; the semantic sourceEnd > sourceOffset relation is enforced separately by validateVideoLayer.'
    tags:
      - schema
      - video
      - edge-case
    anchors:
      - packages/schema/src/layer.ts:62-68
    enforcement: per-field min/positive/max bounds
    appliesTo: ["#layer-schema"]
  layer-clamps-and-min-points:
    description: 'Layer normalized properties are clamped to physical ranges — opacity and tint.amount are min(0).max(1), and a MotionPath must have at least 2 points (min(2)) since a path needs a start and an end. assetId/id/src use min(1) so empty strings are rejected as missing rather than accepted as blank.'
    tags:
      - schema
      - clamp
      - validation
    anchors:
      - packages/schema/src/layer.ts:15
      - packages/schema/src/layer.ts:115
      - packages/schema/src/layer.ts:123-126
    enforcement: min/max clamp + min(1) non-empty
    appliesTo: ["#layer-schema"]
  animatable-property-canonical-enum:
    description: 'AnimatablePropertySchema is THE canonical enumeration of every animatable property path (frame.x, opacity, visual.fill.color, tint.amount, etc.) and is imported by the MCP layer as the single source of truth. A delta whose property is not in this enum fails validation — adding a new animatable property means editing this list, not just the resolver.'
    tags:
      - schema
      - core-invariant
      - canonical-source
    anchors:
      - packages/schema/src/delta.ts:4-40
    enforcement: z.enum allowlist of property paths
    appliesTo: ["#delta-schema"]
  frame-range-ordering-refinement:
    description: 'FrameRangeSchema is a 2-tuple of non-negative integers (min(0)) with a refine guaranteeing end >= start, so a range is always well-ordered. Note end == start is permitted (zero-length / instantaneous range), matching the resolver treating start == end as instantaneous progress 1.'
    tags:
      - schema
      - edge-case
      - refinement
    anchors:
      - packages/schema/src/delta.ts:42-47
    enforcement: tuple int min(0) + refine end >= start
    appliesTo: ["#delta-schema"]
  delta-values-unvalidated-at-parse:
    description: 'DeltaSchema declares from and to as z.unknown() — their type compatibility with the target property (number vs hex color vs boolean) is intentionally NOT checked at parse time. Value/type correctness is the resolver''s interpolateValue concern, so a delta can parse cleanly yet still carry a mismatched from/to.'
    tags:
      - schema
      - gotcha
      - boundary
    anchors:
      - packages/schema/src/delta.ts:55-56
    enforcement: z.unknown() — type checked downstream
    appliesTo: ["#delta-schema"]
  flat-ai-readable-error-shape:
    description: 'formatErrors flattens every Zod issue into { path, message } where path is the issue path joined with "." and falls back to "(root)" for top-level errors. This flat shape is the contract the MCP/AI layer relies on — nested Zod error trees never leak out, so callers can render or reason over a simple list.'
    tags:
      - validation
      - api-contract
      - ai-readable
    anchors:
      - packages/schema/src/validate.ts:19-24
    enforcement: issue.path.join + "(root)" fallback
    appliesTo: ["#validation-functions"]
  video-semantic-checks-beyond-zod:
    description: 'validateVideoLayer enforces the ^valid-video-layer constraints that Zod cannot express — sourceEnd must be > the effective sourceOffset (defaulting to 0), and when a videoMetaDuration is supplied both sourceEnd and sourceOffset must stay within it. Error messages interpolate the actual offending values so an author sees the exact numbers, not just a rule name.'
    tags:
      - validation
      - video
      - semantic
    anchors:
      - packages/schema/src/validate.ts:67-88
    enforcement: cross-field compare with value-rich messages
    appliesTo: ["#validation-functions"]
  recipe-warnings-side-channel:
    description: 'validateRecipe returns success: true for a structurally valid recipe but attaches a separate warnings array (not errors) for every RESERVED_RECIPE_FIELDS member that is present — reserved Phase 3 fields are forward-compatible, not fatal. The warnings key is only added when non-empty, so consumers must treat its absence as zero warnings.'
    tags:
      - validation
      - recipe
      - forward-compat
    anchors:
      - packages/schema/src/validate.ts:107-117
    enforcement: success + conditional warnings array
    appliesTo: ["#validation-functions"]
  recipe-strict-no-unknown-keys:
    description: 'Every recipe block is .strict() — SilencePolicy, CaptionStyle, CaptionGrouping, OverlayTextStyle, the overlay rules, OverlayRules, and StudioRecipe itself all reject unknown keys. A typo''d or unsupported field is a hard validation error, not silently dropped, which is what makes recipes a precise authoring contract rather than a loose bag of options.'
    tags:
      - schema
      - recipe
      - strict
      - core-invariant
    anchors:
      - packages/schema/src/recipe.ts:10
      - packages/schema/src/recipe.ts:108-122
      - packages/schema/src/recipe.ts:152
    enforcement: .strict() on every recipe object
    appliesTo: ["#recipe-schema"]
  page-number-format-template-syntax:
    description: 'validatePageNumberFormat is a superRefine guarding the page-number template: it rejects an empty string, requires balanced braces (count of "{" == count of "}"), requires every "{...}" group to match (current|total) with an optional ":0Nd" zero-pad suffix, and requires at least one {current} or {total} placeholder. It validates SYNTAX only — render-time substitution is a separate concern.'
    tags:
      - validation
      - recipe
      - template
      - edge-case
    anchors:
      - packages/schema/src/recipe.ts:54-100
    enforcement: superRefine — brace balance + group regex
    appliesTo: ["#recipe-schema"]
  recipe-phase-split-strict-vs-opaque:
    description: 'StudioRecipe splits fields by phase — Phase 1 / 1.5 blocks (silence_policy, caption_style, caption_grouping, overlay_rules) are fully typed and strictly validated, while Phase 3 reserved fields (caption_highlight, transition_kit, palette, audio_policy, aspect_targets) are z.unknown() and pass through parse-opaque. RESERVED_RECIPE_FIELDS is the single tuple that both documents the split and drives the validateRecipe warnings.'
    tags:
      - schema
      - recipe
      - phasing
      - convention
    anchors:
      - packages/schema/src/recipe.ts:139-151
      - packages/schema/src/recipe.ts:155-161
    enforcement: typed blocks vs z.unknown() reserved tuple
    appliesTo: ["#recipe-schema"]
  yaml-parse-never-throws:
    description: 'parseAtelier wraps yamlParse in try/catch and converts a parse failure into a ValidationResult with path "(yaml)" rather than throwing, so YAML syntax errors and schema errors flow back through the SAME ValidationResult shape. Callers handle one unified failure type instead of mixing exceptions with result objects.'
    tags:
      - parsing
      - api-contract
      - error-handling
    anchors:
      - packages/schema/src/parse.ts:11-20
    enforcement: try/catch to ValidationResult, never throw
    appliesTo: ["#yaml-parser"]
  artifact-slot-closed-kind-open-tail:
    description: 'SlotRefSchema enforces a hybrid contract — the first dot-separated segment (kind) is a CLOSED Zod enum (image|video|audio|text|font|voice|logo); everything after the first dot is OPEN and creator-extensible, with the only structural rule being ≥1 non-empty tail segment. This is what reconciles the artifact spec''s own examples mixing two-segment (font.display) and four-segment (audio.sfx.transition.whoosh) refs while still failing fast on a typo''d kind.'
    tags:
      - schema
      - artifacts
      - slot
      - core-invariant
    anchors:
      - packages/schema/src/artifacts/slot.ts:25-33
      - packages/schema/src/artifacts/slot.ts:45-61
    enforcement: superRefine — kind in closed enum + ≥1 non-empty tail segment
    appliesTo: ["#artifact-schemas"]
  artifact-script-discriminated-union:
    description: 'ScriptArtifactSchema is a z.discriminatedUnion on the literal "mode" field across narrated | carousel | text-only — narrated has the four ordered blocks (hook/story/proof/cta), carousel and text-only use a flat beats list. A wrong or missing mode yields a single clear error instead of unioning every branch error. Adding a new script mode requires both a literal("mode") member and a union entry.'
    tags:
      - schema
      - artifacts
      - script
      - discriminated-union
    anchors:
      - packages/schema/src/artifacts/script.ts:79-83
    enforcement: z.discriminatedUnion on "mode" literal
    appliesTo: ["#artifact-schemas"]
  artifact-validator-result-shape-deviates-from-recipe-idiom:
    description: 'validateArtifactSet returns { ok: boolean, warnings: string[], errors: string[] } — intentionally different from validateRecipe''s { success: true, warnings?: [] } idiom. The artifacts surface validates multiple independent rules whose severities differ (some warn-only pre-VO, others hard fails) and flattening to a single discriminated result loses that. Callers handle warn vs. error decisions themselves; the validator never throws.'
    tags:
      - validation
      - artifacts
      - api-contract
      - deliberate-asymmetry
    anchors:
      - packages/schema/src/artifacts/validate.ts:18-22
    enforcement: explicit ok/warnings/errors shape; never throws
    appliesTo: ["#artifact-schemas"]
  artifact-technique-library-validated-cross-artifact:
    description: 'StoryboardArtifactSchema validates techniques as `string[]` at the pure-Zod level — the closed-enum membership check happens in validateArtifactSet, which resolves the active library via technique_library_version (integer; per artifact spec §9 Q4). This keeps the schema version-agnostic while still hard-failing on unknown technique strings at validate time. v1 ships four techniques drawn from the artifact spec''s STORYBOARD EXAMPLE.'
    tags:
      - schema
      - artifacts
      - storyboard
      - versioning
    anchors:
      - packages/schema/src/artifacts/storyboard.ts:71
      - packages/schema/src/artifacts/validate.ts:84-104
      - packages/schema/src/artifacts/technique.ts:28-37
    enforcement: schema = string[]; validateArtifactSet checks library membership
    appliesTo: ["#artifact-schemas"]
  artifact-b-roll-id-exemption:
    description: 'Cross-artifact beat-id matching has one explicit exemption — a STORYBOARD beat whose id starts with `b-roll.` does NOT need a matching SCRIPT beat. This is what lets Lux add storyboard-only B-roll beats without forcing Quill to write a corresponding script line. The prefix is checked literally via String#startsWith(''b-roll.''); any other dot-namespaced id (e.g. `intro.cards`) still requires a script match.'
    tags:
      - validation
      - artifacts
      - cross-artifact
      - edge-case
    anchors:
      - packages/schema/src/artifacts/storyboard.ts:84-86
      - packages/schema/src/artifacts/validate.ts:46-54
    enforcement: literal prefix check on storyboard beat id
    appliesTo: ["#artifact-schemas"]
  artifact-parser-frontmatter-plus-body-universal:
    description: 'All three artifact parsers share the same outer shape — leading `---` fence, YAML frontmatter mapping, closing `---` fence, then a Markdown body. splitFrontmatter() is the shared splitter (rejects missing-fence with a clear error and never throws on otherwise-valid YAML failures without context). Per-artifact parsers then lift body content into typed fields: DESIGN keeps the body verbatim, SCRIPT extracts `# Hook/Story/Proof/CTA` H1 lists in narrated mode (flat YAML list otherwise), STORYBOARD extracts `## <beat-id>` H2 sections each with a YAML mapping. Beats live in the body (not frontmatter) so single-beat edits diff cleanly — the load-bearing re-entry property per artifact spec §7.'
    tags:
      - parsing
      - artifacts
      - convention
    anchors:
      - packages/schema/src/artifacts/parse.ts:38-72
      - packages/schema/src/artifacts/parse.ts:84-95
    enforcement: shared splitter + per-artifact body shape
    appliesTo: ["#artifact-schemas"]
  yaml-safe-by-default-data-only:
    description: 'parseAtelier uses the yaml package''s parse, which returns plain JavaScript data (objects, arrays, scalars) with no tag-based code execution — untrusted document YAML cannot instantiate arbitrary classes or run code. The parsed value is then immediately fed through validateDocument, so raw untrusted input is never trusted before schema validation.'
    tags:
      - parsing
      - security
      - core-invariant
    anchors:
      - packages/schema/src/parse.ts:1
      - packages/schema/src/parse.ts:13
      - packages/schema/src/parse.ts:20
    enforcement: plain-data parse then schema-validate
    appliesTo: ["#yaml-parser"]
