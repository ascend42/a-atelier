{
  "name": "atelier",
  "private": true,
  "description": "AI-native animation engine — declarative YAML format authored through MCP tools",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.cjs",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "release:dry": "turbo run build && pnpm -r publish --dry-run --no-git-checks",
    "release": "turbo run build && pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "canvas"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
