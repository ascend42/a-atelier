version: 1.0.0
name: atelier
description: AI-native animation engine — declarative YAML format authored through MCP tools
context:
  - Atelier is a machine-first animation format and engine
  - AI agents author animations through MCP tools, never editing files directly
  - Human collaborators verify visual output and provide feedback
  - Format uses YAML (.atelier extension) for inspectability
  - Paradigm framework conventions apply to all packages

components:
  #atelier-types:
    description: Pure TypeScript type definitions for the animation format
    file: packages/types/src/index.ts
    tags: [foundation, types]
  #atelier-schema:
    description: Zod validation schemas with AI-readable error messages
    file: packages/schema/src/index.ts
    tags: [validation]
    components: ["#atelier-types"]
  #atelier-math:
    description: Pure interpolation engine — easing, lerp, spring, color
    file: packages/math/src/index.ts
    tags: [math, interpolation]
  #atelier-core:
    description: Animation engine — delta resolution, builder API, state machine
    file: packages/core/src/index.ts
    tags: [engine, core]
    components: ["#atelier-types", "#atelier-schema", "#atelier-math"]
  #atelier-canvas:
    description: Canvas 2D renderer and playback controller
    file: packages/canvas/src/index.ts
    tags: [renderer, canvas]
    components: ["#atelier-core"]
  #atelier-mcp:
    description: MCP server — AI authoring interface for animations
    file: packages/mcp/src/index.ts
    tags: [mcp, ai-interface]
    components: ["#atelier-core", "#atelier-canvas", "#atelier-schema"]
  #atelier-cli:
    description: CLI tool — validate, preview, render, info commands
    file: packages/cli/src/index.ts
    tags: [cli, tool]
    components: ["#atelier-core", "#atelier-canvas", "#atelier-schema"]

flows:
  $animation-authoring:
    description: AI creates animation through MCP tools end-to-end
    steps:
      - { component: "#atelier-mcp", action: "create_animation" }
      - { component: "#atelier-mcp", action: "add_layer" }
      - { component: "#atelier-mcp", action: "add_delta" }
      - { component: "#atelier-mcp", action: "preview_frame" }
      - { component: "#atelier-mcp", action: "export" }
  $frame-resolution:
    description: Document + frame number → computed layer states
    steps:
      - { component: "#atelier-core", action: "collect active deltas" }
      - { component: "#atelier-math", action: "interpolate values" }
      - { component: "#atelier-core", action: "merge into layer state" }
  $render-pipeline:
    description: Resolved frame → canvas draw calls → pixels
    steps:
      - { component: "#atelier-core", action: "resolveFrame()" }
      - { component: "#atelier-canvas", action: "renderFrame()" }

gates:
  ^valid-document:
    description: Animation document passes Zod schema validation
  ^no-overlap:
    description: No overlapping deltas on same layer+property+range
  ^valid-delta:
    description: Delta references existing layer and valid property

signals:
  "!animation-created":
    description: New animation document created via MCP
    category: system
  "!frame-rendered":
    description: Frame successfully rendered to canvas
    category: system
  "!validation-failed":
    description: Schema validation rejected input
    category: system
    severity: warn
